#!/usr/bin/env bash
# Init script to start, stop, and restart manage_my_process

PID_FILE="/var/run/my_process.pid"
PROG_PATH="./manage_my_process"

case "$1" in
    start)
        # Run the script in the background and detach it
        $PROG_PATH &
        # Save the PID of the background process ($!) to the file
        echo "$!" > "$PID_FILE"
        echo "manage_my_process started"
        ;;
    stop)
        if [ -f "$PID_FILE" ]; then
            # Kill the process using the saved PID and delete the file
            kill "$(cat "$PID_FILE")" 2>/dev/null
            rm -f "$PID_FILE"
        fi
        echo "manage_my_process stopped"
        ;;
    restart)
        if [ -f "$PID_FILE" ]; then
            kill "$(cat "$PID_FILE")" 2>/dev/null
            rm -f "$PID_FILE"
        fi
        $PROG_PATH &
        echo "$!" > "$PID_FILE"
        echo "manage_my_process restarted"
        ;;
    *)
        echo "Usage: manage_my_process {start|stop|restart}"
        exit 1
        ;;
esac
